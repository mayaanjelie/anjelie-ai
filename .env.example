# ============================================================
# PassPort App — Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# ---  Shopify App Credentials ---
# From your Shopify Partners dashboard > Apps > [Your App] > App setup
SHOPIFY_API_KEY=your_shopify_api_key_here
SHOPIFY_API_SECRET=your_shopify_api_secret_here

# Your app's public URL (no trailing slash)
# In development: use ngrok or Cloudflare Tunnel URL
# In production: your Vercel deployment URL
HOST=https://your-app.vercel.app
NEXT_PUBLIC_HOST=https://your-app.vercel.app

# --- Supabase ---
# From your Supabase project > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Anthropic (Claude AI) ---
# From https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# --- App Settings ---
NODE_ENV=development
